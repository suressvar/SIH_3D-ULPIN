# Local development; never commit .env. Compose substitutes its internal service hosts.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://astra_app:astra_app_local@localhost:54329/astra
REDIS_URL=redis://localhost:63799/0
CORS_ORIGINS=["http://localhost:3000"]
# Required for authenticated requests; no demo auth bypass.
SUPABASE_URL=
JWT_AUDIENCE=authenticated
STORAGE_BACKEND=local
STORAGE_ROOT=data/objects
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=20971520
REQUESTS_PER_MINUTE=120

# Optional real asset generation. Leave unset to report unavailable.
BLENDER_EXECUTABLE=
NODE_EXECUTABLE=
GLTF_VERIFY_SCRIPT=
# Local vetted model weights; no download or inference is fabricated.
SEGFORMER_WEIGHTS=
# Set SEGFORMER_BUILDING_CLASS to the supplied model's documented class index.
POINTNET_WEIGHTS=
MAX_RASTER_PIXELS=16000000
MAX_POINT_COUNT=200000
MAX_VERTICAL_EXTENT_M=1000
