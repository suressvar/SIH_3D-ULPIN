{
  "name": "astra-vi-workspace",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "postinstall": "node scripts/cesium-assets.mjs",
    "lint": "eslint src",
    "postbuild": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "tailwindcss": "3.4.19",
    "@tanstack/react-query": "5.102.8",
    "zustand": "5.0.15",
    "cesium": "1.145.0",
    "maplibre-gl": "6.9.0",
    "@turf/turf": "7.4.0",
    "lucide-react": "0.577.0",
    "@supabase/supabase-js": "2.116.0",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "22.20.2",
    "postcss": "8.5.28",
    "autoprefixer": "10.6.0",
    "vitest": "5.0.0",
    "@playwright/test": "1.63.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "prettier": "3.9.6"
  },
  "overrides": {
    "postcss": "$postcss"
